DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/granovo
# Development only; production must use HTTPS and secure cookies.
GRANOVO_ENV=development
GRANOVO_HOST=127.0.0.1
GRANOVO_PORT=8000
# Set to 1 only for isolated local HTTP development.
GRANOVO_ALLOW_HTTP=0
# Comma-separated proxy addresses trusted to set forwarded headers.
GRANOVO_FORWARDED_ALLOW_IPS=127.0.0.1
# Directory for the SQLite fallback database when DATABASE_URL is unset.
GRANOVO_DATA_DIR=.
