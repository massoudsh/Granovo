# Copy to .env and set a strong, URL-safe password before running docker compose.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Local HTTP only. Set to 0 behind an HTTPS reverse proxy.
GRANOVO_ALLOW_HTTP=1
# Host port published on 127.0.0.1.
GRANOVO_PORT=8000
# Only trust forwarded headers from your reverse proxy address.
GRANOVO_FORWARDED_ALLOW_IPS=127.0.0.1
# Base images. Point these at a registry mirror if Docker Hub is unreachable.
POSTGRES_IMAGE=postgres:17-alpine
PYTHON_IMAGE=python:3.12-slim
# PyPI index used during the image build. Set a mirror if pypi.org is slow or blocked.
PIP_INDEX_URL=https://pypi.org/simple
